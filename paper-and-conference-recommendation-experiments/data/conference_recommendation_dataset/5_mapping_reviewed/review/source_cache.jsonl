tem menu-item-type-taxonomy menu-item-object-category menu-item-has-children menu-item-264\"><a href=\"https://iapr.org/articles/newsletter/\">IAPR Newsletter</a>\n\t<ul class=\"sub-menu\">\n\t\t<li id=\"menu-item-1436\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-1436\"><a href=\"https://iapr.org/publications/iapr-newsletter-archive/\">IAPR Newsletter Archive</a></li>\n\t</ul>\n</li>\n\t<li id=\"menu-item-374\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-374\"><a href=\"https://iapr.org/publications/iapr-publications/\">IAPR Publications</a></li>\n\t<li id=\"menu-item-371\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-371\"><a href=\"https://iapr.org/publications/newsletter-editors-in-chief/\">Newsletter Editors-in-Chief</a></li>\n</ul>\n</li>\n<li id=\"menu-item-10\" class=\"left menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-10\"><a href=\"https://iapr.org/news/\">News</a>\n<ul class=\"sub-menu\">\n\t<li id=\"menu-item-1219\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-1219\"><a href=\"https://iapr.org/news/\">All IAPR News</a></li>\n\t<li id=\"menu-item-1218\" class=\"menu-item menu-item-type-taxonomy menu-item-object-category menu-item-1218\"><a href=\"https://iapr.org/articles/gb-archive/\">Governing Board Meetings</a></li>\n\t<li id=\"menu-item-276\" class=\"menu-item menu-item-type-post_type menu-item-object-page menu-item-276\"><a href=\"https://iapr.org/news/announce-list/\">Subscribe to Our Mailing List</a></li>\n</ul>\n</li>\n</ul></div>\t\t\t\t\t\t\t\t\t\t\t<div class=\"menu-search\">\n\t\t\t\t\t\t\t<div class=\"search-icon\"></div>\n\t\t\t\t\t\t\t<form method=\"get\" class=\"searchform\" action=\"https://iapr.org/\">\n\t\t\t\t\t\t\t\t<input type=\"text\" class=\"field\" name=\"s\" value=\"\" />\n\t\t\t\t\t\t\t</form>\t\n\t\t\t\t\t\t</div><!-- .menu-search -->\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</nav><!-- #site-navigation -->\n\t\t\t</div><!-- .container -->\n\t\t</header><!-- #masthead -->\n\t\n\t\n\t\n\t<div id=\"content\" class=\"site-content\">\n\n\t\t\n\t\t\t<header class=\"entry-header\">\n\t\t\t<div class=\"container\">\n\t\t\t\t<h1 class=\"entry-title\">International Conference on Pattern Recognition</h1><div class=\"breadcrumbs\"><span property=\"itemListElement\" typeof=\"ListItem\"><a property=\"item\" typeof=\"WebPage\" title=\"Go to International Association for Pattern Recognition.\" href=\"https://iapr.org\" class=\"home\" ><span property=\"name\">Home</span></a><meta property=\"position\" content=\"1\"></span> &raquo; <span property=\"itemListElement\" typeof=\"ListItem\"><a property=\"item\" typeof=\"WebPage\" title=\"Go to Conferences.\" href=\"https://iapr.org/conferences/\" class=\"post post-page\" ><span property=\"name\">Conferences</span></a><meta property=\"position\" content=\"2\"></span> &raquo; <span property=\"itemListElement\" typeof=\"ListItem\"><a property=\"item\" typeof=\"WebPage\" title=\"Go to International Conference on Pattern Recognition.\" href=\"https://iapr.org/conferences/international-conference-on-pattern-recognition/\" class=\"post post-page current-item\" aria-current=\"page\"><span property=\"name\">International Conference on Pattern Recognition</span></a><meta property=\"position\" content=\"3\"></span></div>\t\t\t</div><!-- .container -->\n\t\t</header><!-- .entry-header -->\n\t\n\t<div class=\"container\">\n\n\t\t<div id=\"primary\" class=\"content-area\">\n\t\t\t<main id=\"main\" class=\"site-main\">\n\n\t\t\t\t\n\t\t\t\t\n<article id=\"post-362\" class=\"post-362 page type-page status-publish has-post-thumbnail hentry\">\n\t\t\t<div class=\"entry-thumbnail\">\n\t\t\t<img width=\"1800\" height=\"1198\" src=\"https://iapr.org/wp-content/uploads/2022/11/255-AD4_2534.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" decoding=\"async\" fetchpriority=\"high\" srcset=\"https://iapr.org/wp-content/uploads/2022/11/255-AD4_2534.jpg 1800w, https://iapr.org/wp-content/uploads/2022/11/255-AD4_2534-300x200.jpg 300w, https://iapr.org/wp-content/uploads/2022/11/255-AD4_2534-1024x682.jpg 1024w, https://iapr.org/wp-content/uploads/2022/11/255-AD4_2534-768x511.jpg 768w, https://iapr.org/wp-content/uploads/2022/11/255-AD4_2534-1536x1022.jpg 1536w\" sizes=\"(max-width: 1800px) 100vw, 1800px\" />\t\t</div>\n\t\n\t<div class=\"entry-content\">\n\t\t\n<p class=\"wp-block-paragraph\">The major event in the IAPR calendar is the biennial International Conference on Pattern Recognition, which attracts scientists, researchers, and practitioners in the field from all over the world; here they are able to listen, to learn, to educate, and to exchange ideas with their colleagues.</p>\n\n\n\n<span id=\"more-362\"></span>\n\n\n\n<p class=\"wp-block-paragraph\">ICPR has been held biennially since 1973. A list of past ICPR&#8217;s can be found on the <a href=\"https://iapr.org/about-us/history-of-iapr/\" data-type=\"page\" data-id=\"517\">History of IAPR</a> page. Past ICPR websites can be found in the <a href=\"https://iapr.org/conferences/conference-archives/\" data-type=\"page\" data-id=\"1274\">Conference Archives</a>.</p>\n\n\n\n<!-- Page-list plugin v.6.3 wordpress.org/plugins/page-list/ -->\n<div class=\"page-list page-list-ext \">\n<div class=\"page-list-ext-item\"><div class=\"page-list-ext-image\"><a href=\"https://iapr.org/conferences/international-conference-on-pattern-recognition/icpr-proposals/\" title=\"ICPR Proposals\"><img decoding=\"async\" src=\"https://iapr.org/wp-content/uploads/2022/11/195-AD4_2428-150x150.jpg\" width=\"150\" alt=\"ICPR Proposals\" /></a></div> <h3 class=\"page-list-ext-title\"><a href=\"https://iapr.org/conferences/international-conference-on-pattern-recognition/icpr-proposals/\" title=\"ICPR Proposals\">ICPR Proposals</a></h3><div class=\"page-list-ext-item-content\">\nThe International Conference on Pattern Recognition (ICPR) is the major scientific event organized under the auspices of the International Association for Pattern Recognition (IAPR). The aim of this conference is to bring together international experts to share their work and experiences and to promote research and development in Pattern Recognition. \n\n\n\n</div></div>\n<div class=\"page-list-ext-item\"><div class=\"page-list-ext-image\"><a href=\"https://iapr.org/conferences/international-conference-on-pattern-recognition/icpr-workshop-application-form/\" title=\"ICPR Workshop Application Form\"><img decoding=\"async\" src=\"https://iapr.org/wp-content/uploads/2022/11/127-AD4_2212-150x150.jpg\" width=\"150\" alt=\"ICPR Workshop Application Form\" /></a></div> <h3 class=\"page-list-ext-title\"><a href=\"https://iapr.org/conferences/international-conference-on-pattern-recognition/icpr-workshop-application-form/\" title=\"ICPR Workshop Application Form\">ICPR Workshop Application Form</a></h3><div class=\"page-list-ext-item-content\">\nThe information contained in the application for ICPR Workshops is used by the Conferences &amp; Meetings Committee (C&amp;M) and the ICPR Workshops Chairs to evaluate the workshop and to form the basis of the agreement between the IAPR/ICPR and the organizers. It is held by the C&amp;M as historical record. The IAPR does not sell, distribute, or pass any personal data to any organization. \n\n\n\n</div></div>\n\n</div>\n\t\t\t</div><!-- .entry-content -->\n\n\t<footer class=\"entry-footer\">\n\t\t\t\t\t</footer><!-- .entry-footer -->\t\n\n</article><!-- #post-## -->\n\n\t\t\t\t\n\t\t\t\n\t\t\t</main><!-- #main -->\n\t\t</div><!-- #primary -->\n\n\t\t\n<div id=\"secondary\" class=\"widget-area\">\n\t\n\t\t<aside id=\"recent-posts-0\" class=\"widget widget_recent_entries\">\n\t\t<h3 class=\"widget-title\">News &#038; Announcements</h3>\n\t\t<ul>\n\t\t\t\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t<a href=\"https://iapr.org/2026/08/50th-anniversary-book-project/\">50th Anniversary Book Project</a>\n\t\t\t\