  <p class=\"mb-0 small\">Nice, France</p>\n        </div>\n\n        <!-- Empty placeholder keeps the grid even -->\n        <div class=\"col-6 col-md-3 mb-4 d-none d-md-block\" aria-hidden=\"true\"></div>\n\n      </div>\n      <p>See all <a href=\"ACMMM_pasteditions.html\">previous editions and proceedings</a>.</p>\n    </section>\n\n\n    <!-- STATS -->\n    <section id=\"stats\" aria-labelledby=\"heading-stats\">\n      <h2 class=\"section-title\" id=\"heading-stats\">Research Track Statistics</h2>\n\n      <div class=\"chart-wrap\">\n        <!--\n          role=\"img\" + aria-label: exposes the chart as a labelled image to screen readers.\n          The <p> inside is the fallback for browsers/AT that cannot render canvas.\n        -->\n        <canvas id=\"mmStatsChart\" role=\"img\"\n          aria-label=\"Bar chart showing ACM MM submitted and accepted papers from 2005 to 2025, with an overlaid line for acceptance ratio. Acceptance ratio has remained broadly stable at 22–29%, while submissions grew from ~500 in 2005 to over 5,000 in 2025.\">\n          <p>Chart not available. Full data is provided in the table below.</p>\n        </canvas>\n      </div>\n\n      <details class=\"mt-3\">\n        <summary class=\"stats-disclosure\">Show full data table</summary>\n        <div class=\"table-responsive mt-2\">\n          <table class=\"table table-striped table-sm stats-table\">\n            <caption>ACM Multimedia Research Track submission and acceptance statistics, 2005–2025</caption>\n            <thead>\n              <tr>\n                <th scope=\"col\">Year</th>\n                <th scope=\"col\">Submitted<sup>*</sup></th>\n                <th scope=\"col\">Accepted</th>\n                <th scope=\"col\">Acceptance Ratio</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>2025</td>\n                <td>5,330</td>\n                <td>1250</td>\n                <td>23.45%</td>\n              </