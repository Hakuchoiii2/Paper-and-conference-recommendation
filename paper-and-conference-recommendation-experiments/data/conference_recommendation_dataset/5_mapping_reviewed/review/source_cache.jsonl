{"body_sha256": "1b3428b0a898f66dc92a5bd517f882d06dada0164d805cabae627107cda05a47", "final_url": "https://www.acmmm.org/index.html", "ok": true, "retrieved_at": "2026-10-30T09:57:15.908543+00:00", "text": "<!doctype html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"utf-8\" />\n  <title>ACM Multimedia (MM) – Main Website</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <meta name=\"description\" content=\"Official main website of the ACM Multimedia (MM) conference\" />\n\n  <!-- Bootstrap CSS (CDN) -->\n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\n    integrity=\"sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==\"\n    crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\n\n  <style>\n    /* ============================================================\n       TOKENS\n    ============================================================ */\n    :root {\n      --brand-dark: #1b3b5f;\n      --brand-light: #dce9f9;\n      --brand-red: #b00020;\n      --border: #e0e4ea;\n    }\n\n    /* ============================================================\n       BASE\n    ============================================================ */\n    body {\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      background-color: #ffffff;\n      /* Prevent horizontal scroll caused by full-bleed sections */\n      overflow-x: hidden;\n    }\n\n    /* ============================================================\n       HERO\n       Uses clamp() for fluid type so there is NO jarring jump\n       between breakpoints.\n         min  → phones  (~320 px wide)  : ~2.0 rem\n         max  → desktop (≥1200 px wide) : 7.5 rem\n    ============================================================ */\n    .hero-section {\n      position: relative;\n      /* fluid height: never smaller than 220px, never taller than 50vh */\n      min-height: clamp(220px, 35vw, 50vh);\n      background-color: var(--brand-dark);\n      color: white;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 1.5rem 1rem;\n    }\n\n    .hero-section h1 {\n      /* fluid: 2rem @ 320px viewport → 7.5rem @ 1200px viewport */\n      font-size: clamp(2rem, 6.5vw + 0.5rem, 7.5rem);\n      font-weight: 700;\n      margin-bottom: 0.5rem;\n      line-height: 1.1;\n    }\n\n    .hero-section p {\n      /* fluid: 1rem @ 320px → 2rem @ 1200px */\n      font-size: clamp(1rem, 2vw + 0.4rem, 2rem);\n      margin: 0.2rem 0;\n    }\n\n    /* ============================================================\n       NAVBAR  – add hamburger toggler for mobile\n    ============================================================ */\n    .navbar-toggler {\n      border-color: rgba(255, 255, 255, 0.5);\n    }\n\n    .navbar-toggler-icon {\n      filter: invert(1);\n    }\n\n    /* ============================================================\n       MAIN CONTENT\n    ============================================================ */\n    main {\n      padding: 2.5rem 1rem 3rem;\n    }\n\n    .section-title {\n      margin-top: 1.5rem;\n      margin-bottom: 0.75rem;\n      border-bottom: 2px solid var(--border);\n      padding-bottom: 0.3rem;\n      color: var(--brand-dark);\n      /* fluid heading */\n      font-size: clamp(1.2rem, 2.5vw + 0.2rem, 1.75rem);\n    }\n\n    /* ============================================================\n       NEXT-CONFERENCE HIGHLIGHT\n    ============================================================ */\n    /* Fluid logo: never wider than 100% of its column */\n    .next-mm-logo-box {\n      max-width: min(450px, 100%);\n      width: clamp(80px, 20vw, 450px);\n      height: auto;\n      margin-bottom: 5px;\n      display: block;\n    }\n\n    .next-mm-tag {\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      font-size: 0.75rem;\n      color: var(--brand-dark);\n      font-weight: 700;\n    }\n\n    .next-mm-link {\n      color: var(--brand-dark);\n      font-weight: 600;\n      text-decoration: none;\n      border-bottom: 1px solid var(--brand-dark);\n    }\n\n    .next-mm-link:hover {\n      color: #0f2742;\n      border-bottom-color: #0f2742;\n    }\n\n    /* ============================================================\n       PAST-EDITIONS GRID\n       Logo cards: two-per-row on phones, four on ≥md\n    ============================================================ */\n    .mm-logo-box {\n      /* fluid width: grows from ~100px to 220px */\n      width: clamp(80px, 18vw, 220px);\n      height: auto;\n      object-fit: contain;\n      margin-bottom: 10px;\n    }\n\n    /* Small utility logo used elsewhere */\n    .mm-logo {\n      height: auto;\n      width: clamp(48px, 8vw, 80px);\n      object-fit: contain;\n      margin-bottom: 10px;\n    }\n\n    .mm-only-logo-box {\n      max-width: 100%;\n      height: auto;\n      margin-bottom: 5px;\n    }\n\n    /* ============================================================\n       BADGE\n    ============================================================ */\n    .badge-new {\n      display: inline-block;\n      margin-right: 6px;\n      padding: 2px 6px;\n      font-size: 0.75rem;\n      font-weight: 600;\n      color: #ffffff;\n      background-color: var(--brand-red);\n      border-radius: 3px;\n      vertical-align: middle;\n    }\n\n    /* ============================================================\n       ANNOUNCEMENTS PANEL\n    ============================================================ */\n    .announcements {\n      background-color: var(--brand-light);\n      border: 1px solid #99b9ea;\n      padding: 1.25rem 0;\n    }\n\n    .announcements-title {\n      color: var(--brand-dark);\n      font-weight: 600;\n      margin-bottom: 0.75rem;\n    }\n\n    .announcements-list {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n    }\n\n    .announcements-item {\n      display: flex;\n      /* On very small screens stack date above text */\n      flex-wrap: wrap;\n      gap: 0.5rem 0.75rem;\n      padding: 0.55rem 0;\n      border-top: 1px solid rgba(153, 185, 234, 0.55);\n      align-items: flex-start;\n      /* prevent pill from stretching to row height */\n    }\n\n    .announcements-item:first-child {\n      border-top: none;\n    }\n\n    .announcements-date {\n      flex: 0 0 auto;\n      width: 5.5rem;\n      /* fixed width → all pills identical size   */\n      text-align: center;\n      /* centre the text inside the pill           */\n      font-weight: 600;\n      color: var(--brand-dark);\n      background: rgba(27, 59, 95, 0.08);\n      border: 1px solid rgba(27, 59, 95, 0.18);\n      border-radius: 999px;\n      padding: 0.15rem 0.6rem;\n      font-size: 0.85rem;\n      line-height: 1.4;\n      white-space: nowrap;\n    }\n\n    .announcements-text {\n      color: var(--brand-dark);\n      flex: 1 1 200px;\n      /* allows wrapping on very small screens */\n    }\n\n    .announcements-note {\n      font-style: italic;\n      color: rgba(27, 59, 95, 0.9);\n    }\n\n    .announcements a {\n      color: var(--brand-dark);\n      text-decoration: underline;\n      text-underline-offset: 2px;\n    }\n\n    .announcements a:hover {\n      text-decoration-thickness: 2px;\n    }\n\n    /* Older announcements — hidden until toggled */\n    .announcements-older {\n      border-top: 1px dashed rgba(27, 59, 95, 0.3);\n      margin-top: 0.25rem;\n      padding-top: 0.25rem;\n    }\n\n    /* Toggle button */\n    .announcements-toggle {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.4rem;\n      margin-top: 0.75rem;\n      padding: 0.3rem 0.75rem;\n      background: transparent;\n      border: 1px solid rgba(27, 59, 95, 0.4);\n      border-radius: 4px;\n      color: var(--brand-dark);\n      font-size: 0.8rem;\n      font-weight: 600;\n      cursor: pointer;\n    }\n\n    .announcements-toggle:hover {\n      background: rgba(27, 59, 95, 0.07);\n    }\n\n    .announcements-toggle:focus-visible {\n      outline: 3px solid #4a90d9;\n      outline-offset: 2px;\n    }\n\n    .toggle-arrow {\n      font-size: 0.6rem;\n      display: inline-block;\n      transition: transform 0.2s ease;\n    }\n\n    .announcements-toggle[aria-expanded=\"true\"] .toggle-arrow {\n      transform: rotate(90deg);\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .toggle-arrow {\n        transition: none;\n      }\n    }\n\n    /* ============================================================\n       CHART\n    ============================================================ */\n    .chart-wrap {\n      background: #ffffff;\n      border: 1px solid rgba(0, 0, 0, 0.1);\n      border-radius: 10px;\n      /* Let the chart breathe on small screens */\n      padding: clamp(8px, 2vw, 16px);\n      /* Prevent the canvas from being squeezed into 0 height */\n      min-height: 200px;\n    }\n\n    /* ============================================================\n       STATS TABLE\n    ============================================================ */\n    .stats-table th,\n    .stats-table td {\n      text-align: center;\n      /* Shrink slightly on phones */\n      font-size: clamp(0.75rem, 1.5vw + 0.2rem, 0.9rem);\n      /* Prevent cells from becoming microscopic */\n      white-space: nowrap;\n    }\n\n    /* ============================================================\n       FOOTER\n    ============================================================ */\n    footer {\n      border-top: none;\n      padding: 1.5rem 1rem;\n      font-size: clamp(0.8rem, 1.5vw + 0.1rem, 0.9rem);\n      color: #f3f6fb;\n      text-align: center;\n      background-color: var(--brand-dark);\n    }\n\n    footer a {\n      color: #dce9f9;\n      text-decoration: none;\n    }\n\n    footer a:hover {\n      color: #ffffff;\n      text-decoration: underline;\n    }\n\n    .social-links a {\n      color: #dce9f9;\n    }\n\n    .social-links a i {\n      color: #ffffff;\n    }\n\n    .social-links a:hover i {\n      color: #dce9f9;\n    }\n\n    /* Social icon: fluid size so it's not enormous on desktop\n       or tiny on mobile */\n    .social-links {\n      font-size: clamp(1.4rem, 3vw + 0.5rem, 2rem);\n    }\n\n    /* ============================================================\n       TOUCH TARGETS\n       Ensure interactive elements are at least 44×44 px on touch\n       devices (WCAG 2.5.5).\n    ============================================================ */\n    @media (hover: none) and (pointer: coarse) {\n\n      .nav-link,\n      footer a,\n      .next-mm-link,\n      .announcements a {\n        padding: 0.4rem 0.1rem;\n        display: inline-block;\n        min-height: 44px;\n        line-height: 2.5;\n      }\n    }\n\n    /* ============================================================\n       COMING UP STRIP\n    ============================================================ */\n    .coming-up-strip {\n      display: flex;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 0.6rem 1rem;\n      margin-top: 0.85rem;\n    }\n\n    .coming-up-label {\n      font-size: 0.75rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      color: var(--brand-dark);\n      white-space: nowrap;\n    }\n\n    .coming-up-chips {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem;\n    }\n\n    .coming-up-chip {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.4rem;\n      padding: 0.2rem 0.7rem;\n      background: #ffffff;\n      border: 1px solid rgba(27, 59, 95, 0.2);\n      border-radius: 999px;\n      font-size: 0.82rem;\n    }\n\n    .coming-up-year {\n      font-weight: 700;\n      color: var(--brand-dark);\n    }\n\n    .coming-up-place {\n      color: rgba(27, 59, 95, 0.7);\n    }\n\n    .coming-up-year::after {\n      content: \"·\";\n      margin-left: 0.35rem;\n      font-weight: 400;\n      color: rgba(27, 59, 95, 0.35);\n    }\n\n    .stats-disclosure {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.4rem;\n      cursor: pointer;\n      font-size: 0.875rem;\n      font-weight: 600;\n      color: var(--brand-dark);\n      border: 1px solid var(--brand-dark);\n      border-radius: 4px;\n      padding: 0.3rem 0.75rem;\n      -webkit-user-select: none;\n      user-select: none;\n      list-style: none;\n      /* remove Safari's default marker */\n    }\n\n    .stats-disclosure::-webkit-details-marker {\n      display: none;\n    }\n\n    .stats-disclosure::before {\n      content: \"▶\";\n      font-size: 0.65rem;\n      transition: transform 0.2s ease;\n      display: inline-block;\n    }\n\n    details[open]>.stats-disclosure::before {\n      transform: rotate(90deg);\n    }\n\n    .stats-disclosure:hover {\n      background-color: rgba(27, 59, 95, 0.07);\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      .stats-disclosure::before {\n        transition: none;\n      }\n    }\n\n\n\n    /* 1. Skip-to-content link (WCAG 2.4.1)\n          Hidden off-screen until focused by keyboard navigation */\n    .skip-link {\n      position: absolute;\n      top: -100%;\n      left: 1rem;\n      z-index: 9999;\n      padding: 0.6rem 1.2rem;\n      background: var(--brand-dark);\n      color: #fff;\n      font-weight: 600;\n      border-radius: 0 0 4px 4px;\n      text-decoration: none;\n      transition: top 0.15s;\n    }\n\n    .skip-link:focus {\n      top: 0;\n      outline: 3px solid #fff;\n      outline-offset: 2px;\n    }\n\n    /* 2. Restore focus rings suppressed by Bootstrap (WCAG 2.4.7)\n          Use the browser's default :focus-visible so mouse users\n          are not affected, only keyboard users. */\n    :focus-visible {\n      outline: 3px solid #4a90d9;\n      outline-offset: 2px;\n    }\n\n    /* Slightly stronger ring on dark backgrounds */\n    .navbar :focus-visible,\n    footer :focus-visible {\n      outline-color: #ffffff;\n    }\n\n    /* 3. Visually hidden utility (used for SR-only text) */\n    .sr-only {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      padding: 0;\n      margin: -1px;\n      overflow: hidden;\n      clip: rect(0, 0, 0, 0);\n      white-space: nowrap;\n      border: 0;\n    }\n\n    /* 4. Contrast fix: announcements-note rgba was ~4.3:1 on light blue,\n          just failing WCAG AA for small text. Full brand colour = 6.5:1. */\n    .announcements-note {\n      font-style: italic;\n      color: var(--brand-dark);\n      /* was rgba(27,59,95,0.9) */\n    }\n\n    /* 5. Respect prefers-reduced-motion for any CSS transitions */\n    @media (prefers-reduced-motion: reduce) {\n\n      *,\n      *::before,\n      *::after {\n        transition-duration: 0.01ms !important;\n        animation-duration: 0.01ms !important;\n      }\n\n      .skip-link {\n        transition: none;\n      }\n    }\n\n    /* ============================================================\n       LANDSCAPE TABLETS / PHONES (orientation: landscape, short viewport)\n       Prevents the hero from consuming the full screen height,\n       keeping content visible above the fold.\n    ============================================================ */\n    @media (orientation: landscape) and (max-height: 500px) {\n      .hero-section {\n        min-height: 140px;\n        padding: 1rem;\n      }\n    }\n\n    /* ============================================================\n       SMALL SCREENS  (≤ 576 px)\n    ============================================================ */\n    @media (max-width: 576px) {\n      main {\n        padding: 1.5rem 0.75rem 2rem;\n      }\n\n      /* Stack next-conference card text to the left on phones */\n      #current-logo .col-12.col-md-6 {\n        text-align: center;\n      }\n\n      /* Give the stats table a bit more room by reducing padding */\n      .stats-table th,\n      .stats-table td {\n        padding: 0.25rem 0.4rem;\n      }\n\n      /* Footer columns: always stacked */\n      footer .row>div+div {\n        margin-top: 0.75rem;\n      }\n    }\n  </style>\n</head>\n\n<!-- Chart.js must load before the canvas script fires -->\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n\n<body>\n\n  <!-- Skip-to-content-->\n  <a class=\"skip-link\" href=\"#main-content\">Skip to main content</a>\n\n  <!-- ============================================================\n       HEADER\n  ============================================================ -->\n  <header class=\"hero-section\">\n    <div>\n      <h1>ACM Multimedia</h1>\n      <p class=\"opacity-75\">The flagship ACM SIGMM conference on multimedia</p>\n    </div>\n  </header>\n\n  <!-- ============================================================\n       NAVBAR \n  ============================================================ -->\n  <nav class=\"navbar navbar-expand-lg navbar-dark\" style=\"background-color: var(--brand-dark);\">\n    <div class=\"container\">\n\n      <!-- Hamburger button (visible only when collapsed) -->\n      <button class=\"navbar-toggler ms-auto\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#mmNavbar\"\n        aria-controls=\"mmNavbar\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n        <span class=\"navbar-toggler-icon\"></span>\n      </button>\n\n      <div class=\"collapse navbar-collapse\" id=\"mmNavbar\">\n        <ul class=\"navbar-nav\">\n          <li class=\"nav-item\">\n            <a class=\"nav-link\" href=\"index.html\">Home</a>\n          </li>\n          <li class=\"nav-item\">\n            <a class=\"nav-link\" href=\"index_pasteditions.html\">Past Editions</a>\n          </li>\n          <li class=\"nav-item\">\n            <a class=\"nav-link\" href=\"index_bidding_2029.html\">Call for Bidding 2029</a>\n          </li>\n        </ul>\n      </div>\n\n    </div>\n  </nav>\n\n\n  <!-- ============================================================\n       MAIN CONTENT\n  ============================================================ -->\n  <main class=\"container\" id=\"main-content\" aria-label=\"Main content\">\n\n    <!-- NEXT CONFERENCE -->\n    <section id=\"current-logo\" class=\"my-5\" aria-labelledby=\"heading-next\">\n      <div class=\"next-mm-highlight py-4\">\n        <div class=\"row align-items-center justify-content-center g-4\">\n\n          <!-- LOGO — always auto-width so it sits beside the text -->\n          <div class=\"col-auto d-flex align-items-center\">\n            <a href=\"https://2026.acmmm.org\" target=\"_blank\" rel=\"noopener\"\n              aria-label=\"ACM MM 2026 website (opens in new tab)\">\n              <img src=\"images/logos/mm26.png\" alt=\"ACM MM 2026 conference logo – Rio de Janeiro\"\n                class=\"next-mm-logo-box\" />\n            </a>\n          </div>\n\n          <!-- TEXT -->\n          <div class=\"col-auto text-center text-md-start\">\n            <div class=\"next-mm-tag mb-2\" id=\"heading-next\">Next Conference</div>\n            <h3 class=\"mb-2\" style=\"color:var(--brand-dark); font-size: clamp(1.1rem, 2.5vw + 0.3rem, 1.75rem);\">\n              ACM MM 2026 · Rio de Janeiro\n            </h3>\n            <p class=\"mb-2\">November 10–14, 2026</p>\n            <a class=\"next-mm-link\" href=\"https://2026.acmmm.org\" target=\"_blank\" rel=\"noopener\"\n              aria-label=\"Visit 2026.acmmm.org (opens in new tab)\">\n              2026.acmmm.org\n            </a>\n          </div>\n        </div>\n      </div>\n\n      <!-- COMING UP strip -->\n      <div class=\"coming-up-strip justify-content-center\" aria-label=\"Future confirmed editions\">\n        <span class=\"coming-up-label\">Coming up</span>\n        <div class=\"coming-up-chips\">\n          <div class=\"coming-up-chip\">\n            <span class=\"coming-up-year\">MM 2027</span>\n            <span class=\"coming-up-place\">Hong Kong</span>\n          </div>\n          <div class=\"coming-up-chip\">\n            <span class=\"coming-up-year\">MM 2028</span>\n            <span class=\"coming-up-place\">London</span>\n          </div>\n        </div>\n      </div>\n\n    </section>\n\n    <!-- ANNOUNCEMENTS -->\n    <section id=\"announcements\" class=\"announcements\" aria-labelledby=\"heading-announcements\">\n      <div class=\"container\">\n        <h2 class=\"h5 announcements-title\" id=\"heading-announcements\">Announcements</h2>\n\n        <ul class=\"announcements-list\">\n          <!-- ── RECENT (always visible) ── -->\n          <li class=\"announcements-item\">\n            <span class=\"announcements-date\">Jun 2026</span>\n            <div class=\"announcements-text\">\n              <span class=\"badge-new\" aria-label=\"New\">NEW</span>\n              <a href=\"call_for_bidding_2029.html\">Call for Bidding for ACM Multimedia 2029</a> is now open.\n            </div>\n          </li>\n\n          <li class=\"announcements-item\">\n            <span class=\"announcements-date\">Apr 2026</span>\n            <div class=\"announcements-text\">\n              <span class=\"announcements-note\">\n                New Bidding Policy Document has been published. <span class=\"announcements-note\">\n                  See details in the <a href=\"#bylaws\">Bylaws and Policies</a> section.\n                </span>\n              </span>\n            </div>\n          </li>\n\n          <li class=\"announcements-item\">\n            <span class=\"announcements-date\">Jan 2026</span>\n            <div class=\"announcements-text\">\n              ACM Multimedia topics have been updated.\n              <span class=\"announcements-note\">\n                See details in the <a href=\"#about\">About</a> section.\n              </span>\n            </div>\n          </li>\n\n\n        </ul>\n\n        <!-- ── OLDER (collapsed by default) ── -->\n        <ul class=\"announcements-list announcements-older\" id=\"older-announcements\" aria-hidden=\"true\" hidden>\n          <li class=\"announcements-item\">\n            <span class=\"announcements-date\">Jan 2026</span>\n            <div class=\"announcements-text\">\n              New Desk-Rejection and Award Policies have been approved.\n              <span class=\"announcements-note\">\n                See details in the <a href=\"#bylaws\">Bylaws and Policies</a> section.\n              </span>\n            </div>\n          </li>\n          <li class=\"announcements-item\">\n            <span class=\"announcements-date\">Nov 2025</span>\n            <div class=\"announcements-text\">\n              ACM MM 2028 will be in London.\n            </div>\n          </li>\n\n          <li class=\"announcements-item\">\n            <span class=\"announcements-date\">Nov 2025</span>\n            <div class=\"announcements-text\">\n              ACM MM 2027 will be in Hong Kong.\n              <span class=\"announcements-note\">Dates to be announced.</span>\n            </div>\n          </li>\n        </ul>\n\n        <!-- Toggle button -->\n        <button type=\"button\" class=\"announcements-toggle\" id=\"older-toggle\" aria-expanded=\"false\"\n          aria-controls=\"older-announcements\">\n          <span class=\"toggle-arrow\" aria-hidden=\"true\">▶</span>\n          <span class=\"toggle-label\">Show older announcements</span>\n        </button>\n\n      </div>\n    </section>\n\n\n    <!-- ABOUT -->\n    <section id=\"about\" aria-labelledby=\"heading-about\">\n      <h2 class=\"section-title\" id=\"heading-about\">About ACM Multimedia</h2>\n      <p>\n        Since its launch in 1993, ACM Multimedia (ACM MM) has been the premier international conference for multimedia\n        research, innovation, and applications. It brings together researchers, practitioners, artists, and industry\n        leaders to present and discuss advances in multimedia systems, content understanding, user experience, and\n        emerging applications.\n      </p>\n      <p>The conference program is organized around a broad set of topics that reflect both foundational research areas\n        and emerging directions in multimedia. The current topics of interest, approved by the Steering Committee,\n        include (in alphabetical order):</p>\n      <ul>\n        <li><strong>Art and Culture</strong></li>\n        <li><strong>Data Systems Management and Indexing</strong></li>\n        <li><strong>Embodied and Immersive Multimedia</strong></li>\n        <li><strong>Emotional and Social Signals</strong></li>\n        <li><strong>Interactions and Quality of Experience</strong></li>\n        <li><strong>Multimedia Applications</strong></li>\n        <li><strong>Multimedia Generative and Foundation Models</strong></li>\n        <li><strong>Multimedia Interpretability and Explainability</strong></li>\n        <li><strong>Multimedia and Language</strong></li>\n        <li><strong>Multimedia Search and Recommendation</strong></li>\n        <li><strong>Multimedia Reasoning</strong></li>\n        <li><strong>Multimodal Fusion</strong></li>\n        <li><strong>New Forms of Media Content</strong></li>\n        <li><strong>Responsible Multimedia</strong></li>\n        <li><strong>Summarization, Analytics, and Storytelling</strong></li>\n        <li><strong>Transport and Delivery</strong></li>\n      </ul>\n      <p>\n        A detailed description of these topics is available in the\n        <a href=\"files/ACMMMTopics_2512.pdf\" target=\"_blank\">ACM Multimedia Topics of Interest</a> document.\n      </p>\n      <p>The conference also features technical sessions, tutorials, panels, and an interactive art exhibit,\n        fostering dialogue between scientific innovation and creative exploration in art and cultural heritage.</p>\n    </section>\n\n\n    <!-- STEERING COMMITTEE -->\n    <section id=\"steering\" aria-labelledby=\"heading-steering\">\n      <h2 class=\"section-title\" id=\"heading-steering\">Steering Committee</h2>\n      <p>\n        The ACM Multimedia Steering Committee provides long-term guidance for the conference series and oversees the\n        selection of future hosts and general chairs.\n      </p>\n      <ul>\n        <li><strong>Chair:</strong> Silvia Rossi (CWI, NL)</li>\n        <li>Abdulmotaleb El Saddik (University of Ottawa, Canada) – <i>SIGMM representative</i></li>\n        <li>Elisa Ricci (University of Trento, Italy) – <i>SIGMM representative</i></li>\n        <li>Vincent Oria (NJIT, USA) – <i>SIGMM representative</i></li>\n        <li>Cathal Gurrinn (Dublin City University, Ireland) – <i>ACMMM'25 representative</i></li>\n        <li>Qin Jin (Renmin University, China) – <i>ACMMM'26 representative</i></li>\n        <li>Zi (Helen) Huang (University of Queensland, Australia) – <i>ACMMM'27 representative</i></li>\n        <li>Dong Xu (University of Hong Kong, Hong Kong) – <i>ACMMM'28 representative</i></li>\n        <li>Xavier Alameda-Pineda (Inria, France) – <i>Member at large</i></li>\n        <li>Joao Magalhães (Universidade Nova de Lisboa, Portugal) – <i>Member at large</i></li>\n        <li>Laura Toni (UCL, UK) – <i>Member at large</i></li>\n        <li>Marco Bertini (University of Florence, Italy) – <i>Member at large</i></li>\n      </ul>\n      <p>\n        For inquiries related to the ACM Multimedia conference series, please contact:<br>\n        acm-multimedia-steering-committee [AT] googlegroups.com\n      </p>\n      <p><strong>Advisory Board:</strong></p>\n      <ul>\n        <li>Alan Smeaton (Dublin City University)</li>\n        <li>Arnold Smeulders (University of Amsterdam)</li>\n        <li>Klara Nahrstedt (University of Illinois)</li>\n        <li>Yong Rui (Lenovo group)</li>\n      </ul>\n    </section>\n\n\n    <!-- BYLAWS / POLICIES -->\n    <section id=\"bylaws\" aria-labelledby=\"heading-bylaws\">\n      <h2 class=\"section-title\" id=\"heading-bylaws\">Bylaws and Policies</h2>\n      <p>This section contains the bylaws and official policies approved by the Steering Committee. These documents\n        describe the rules and procedures that guide the organization of the conference, including the recently approved\n        Desk-Reject and Award Policies.</p>\n      <ul>\n        <li>\n          <a href=\"files/ACMMMBylaws_202606.pdf\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"ACM Multimedia Bylaws, PDF, opens in new tab\">\n            ACM Multimedia Bylaws\n          </a>\n          <span class=\"sr-only\">(PDF)</span>\n          (<i>last update: June, 2026</i>)\n        </li>\n        <li>\n          <span class=\"badge-new\" aria-label=\"New\">NEW</span>\n          <a href=\"files/ACMMMTopics_2512.pdf\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"ACM Multimedia Topics of Interest, PDF, opens in new tab\">\n            ACM Multimedia Topics of Interest\n          </a>\n          <span class=\"sr-only\">(PDF)</span>\n          (<i>approved December, 2025</i>)\n        </li>\n        <li>\n          <span class=\"badge-new\" aria-label=\"New\">NEW</span>\n          <a href=\"files/ACMMMDeskRej_2025.pdf\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"Desk-Rejection Policy, PDF, opens in new tab\">\n            Desk-Rejection Policy\n          </a>\n          <span class=\"sr-only\">(PDF)</span>\n          (<i>approved December, 2025</i>)\n        </li>\n        <li>\n          <span class=\"badge-new\" aria-label=\"New\">NEW</span>\n          <a href=\"files/ACMMMAwardPolicy_2025.pdf\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"Award Policy, PDF, opens in new tab\">\n            Award Policy\n          </a>\n          <span class=\"sr-only\">(PDF)</span>\n          (<i>approved December, 2025</i>)\n        </li>\n        <li>\n          <span class=\"badge-new\" aria-label=\"New\">NEW</span>\n          <a href=\"files/ACMMMBiddingPolicy_2602.pdf\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"Bidding Policy, PDF, opens in new tab\">\n            Bidding Policy\n          </a>\n          <span class=\"sr-only\">(PDF)</span>\n          (<i>approved February, 2026</i>)\n        </li>\n      </ul>\n      <p class=\"small-note\">\n        A summary of the December 2025 Steering Committee voting outcomes is available\n        <a href=\"files/ACMMMVoteReport_2512.pdf\" target=\"_blank\" rel=\"noopener\"\n          aria-label=\"Voting outcomes summary, PDF, opens in new tab\">here<span class=\"sr-only\"> (PDF)</span></a>.\n      </p>\n    </section>\n\n\n    <!-- PAST EDITIONS -->\n    <section id=\"past-editions\" class=\"my-5\" aria-labelledby=\"heading-past\">\n      <h2 class=\"section-title\" id=\"heading-past\">Past Editions</h2>\n      <div class=\"row text-center\">\n\n        <div class=\"col-6 col-md-3 mb-4\">\n          <a href=\"https://2025.acmmm.org\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"ACM MM 2025, Dublin, Ireland (opens in new tab)\">\n            <img src=\"images/logos/mm25.png\" alt=\"ACM MM 2025 logo\" class=\"mm-logo-box\" />\n          </a>\n          <h3 class=\"mb-1 small\">ACM MM 2025</h3>\n          <p class=\"mb-0 small\">Dublin, Ireland</p>\n        </div>\n\n        <div class=\"col-6 col-md-3 mb-4\">\n          <a href=\"https://2024.acmmm.org\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"ACM MM 2024, Melbourne, Australia (opens in new tab)\">\n            <img src=\"images/logos/mm24.png\" alt=\"ACM MM 2024 logo\" class=\"mm-logo-box\" />\n          </a>\n          <h3 class=\"mb-1 small\">ACM MM 2024</h3>\n          <p class=\"mb-0 small\">Melbourne, Australia</p>\n        </div>\n\n        <div class=\"col-6 col-md-3 mb-4\">\n          <a href=\"https://2023.acmmm.org\" target=\"_blank\" rel=\"noopener\"\n            aria-label=\"ACM MM 2023, Ottawa, Canada