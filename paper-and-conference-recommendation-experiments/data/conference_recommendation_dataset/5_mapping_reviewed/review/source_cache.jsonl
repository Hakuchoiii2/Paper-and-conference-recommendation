ionCountry');\r\n\r\n                            var selectedValueCountry = fieldsCountry.options[fieldsCountry.selectedIndex].value;\r\n\r\n                            if (selectedValueCountry != \"Select a Country\") {\r\n                                args.IsValid = true;\r\n                            }\r\n\r\n                            var fields = document.getElementById('ctl00_MasterPageHeader_RadMenu1_i8_ctl00_DropDownListAffiliation');\r\n\r\n                            var selectedValue = fields.options[fields.selectedIndex].value;\r\n\r\n                            if (selectedValue != \"Select a Subject\") {\r\n                                args.IsValid = true;\r\n                            }\r\n                        }\r\n                        function doCustomValidate(source, args) {\r\n\r\n                            args.IsValid = false;\r\n\r\n                            if (document.getElementById('ctl00_MasterPageHeader_RadMenu1_i3_ctl00_PaperTitle').value.length > 0) {\r\n                                args.IsValid = true;\r\n                            }\r\n                            if (document.getElementById('ctl00_MasterPageHeader_RadMenu1_i3_ctl00_PaperAuthor').value.length > 0) {\r\n                                args.IsValid = true;\r\n                            }\r\n                            if (document.getElementById('ctl00_MasterPageHeader_RadMenu1_i3_ctl00_PaperAffiliation').value.length > 0) {\r\n                                args.IsValid = true;\r\n                            }\r\n                            var fields = document.getElementById('ctl00_MasterPageHeader_RadMenu1_i3_ctl00_DropDownListPaperField');\r\n\r\n                            var selectedValue = fields.options[fields.selectedIndex].value;\r\n\r\n                            if (selectedValue != \"Select a Subject\") {\r\n                                args.IsValid = true;\r\n                            }\r\n                        }\r\n\r\n                        function hoverTextFunction(description) {\r\n                            var topicName = document.getElementById(description.id).textContent;\r\n                            document.getElementById(\"menuActionText1\").innerHTML = topicName;\r\n                        }\r\n                        function hoverTextFunctionProceeding(description) {\r\n                            var topicName = document.getElementById(description.id).textContent;\r\n                            document.getElementById(\"menuActionText2\").innerHTML = topicName;\r\n                        }\r\n                        function hoverTextFunctionAuthors(description) {\r\n                            var topicName = document.getElementById(description.id).textContent;\r\n                            document.getElementById(\"menuActionText3\").innerHTML = topicName;\r\n                        }\r\n                        function hoverTextFunctionAffiliation(description) {\r\n                            var topicName = document.getElementById(description.id).textContent;\r\n                            document.getElementById(\"menuActionText4\").innerHTML = topicName;\r\n                        }\r\n                   \r\n\r\n\r\n\r\n                    </script>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </nav>\r\n\r\n</header>\r\n\r\n<div id=\"ctl00_MasterPageHeader_RadToolTip\" class=\"RadToolTipInfo\" style=\"display:none;position:absolute;\">\r\n\t\r\n    <img id=\"MasterPageHeader_Image11\" src=\"App_Themes/BookStore/images/PopupInfo.png\" />\r\n    <p></p>\r\n    <div style=\"padding: 7px 14px !important;\">\r\n        <span id=\"MasterPageHeader_Label17\">\r\n                                                        The Search is performed on all of the following fields:\r\n                                                        <p></p>\r\n                                                        Note: Please use complete words only.\r\n     