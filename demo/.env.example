# ==============================================================================
# DS300 FacetRec - Unified Demo Environment Configuration
# ==============================================================================
# File cấu hình duy nhất đặt tại thư mục: demo/.env
# ==============================================================================

# Chế độ chạy Model Extractor:
# - false: Dùng bộ tách heuristic nhanh (dùng để test giao diện và luồng API không cần GPU)
# - true: Nạp mô hình LLM + PEFT LoRA adapter thật để trích xuất 5 facet
ENABLE_REAL_LLM=true

# Thiết bị chạy inference: 'cuda' (GPU) hoặc 'cpu'
# Lưu ý: Với GPU RTX 3050 Laptop 4GB VRAM, bắt buộc bật LOAD_IN_4BIT=true
DEVICE=cuda
LOAD_IN_4BIT=true

# Model LLM mặc định cho máy local (Khuyên dùng Qwen3-4B vì vừa vặn 4GB VRAM)
LOCAL_ACTIVE_MODEL=Qwen3-4B

# Hugging Face Token (cần thiết khi tải base model từ Hugging Face Hub nếu chưa có)
HF_TOKEN=

# Hugging Face Cache & Base Models (Ưu tiên dùng ổ E để không bị đầy ổ C)
HF_HOME=../paper-and-conference-recommendation-experiments/models/huggingface
TRANSFORMERS_CACHE=../paper-and-conference-recommendation-experiments/models/huggingface/hub

# Đường dẫn base model Qwen4B cục bộ trên ổ E (đã tải sẵn snapshot, không tải lại)
BASE_MODEL_QWEN4B=../../paper-and-conference-recommendation-experiments/models/huggingface/models--Qwen--Qwen3-4B-Instruct-2507/snapshots/cdbee75f17c01a7cc42f958dc650907174af0554
BASE_MODEL_QWEN8B=Qwen/Qwen3-8B
BASE_MODEL_QWEN14B=Qwen/Qwen3-14B
BASE_MODEL_LLAMA8B=meta-llama/Meta-Llama-3.1-8B-Instruct
BASE_MODEL_GEMMA9B=google/gemma-2-9b-it

# Đường dẫn thư mục chứa các LoRA adapter (tương đối từ demo/ hoặc tuyệt đối)
ADAPTER_ROOT=../_local/adapter

# Đường dẫn chi tiết từng adapter trong _local/adapter
ADAPTER_QWEN4B_PATH=../_local/adapter/Qwen4B
ADAPTER_QWEN8B_PATH=../_local/adapter/Qwen8B
ADAPTER_QWEN14B_PATH=../_local/adapter/Qwen14B
ADAPTER_LLAMA8B_PATH=../_local/adapter/Llama8B
ADAPTER_GEMMA9B_PATH=../_local/adapter/Gemma9B

# ==============================================================================
# Dữ liệu Demo & Precomputed Artifacts (tương đối từ thư mục demo/)
# ==============================================================================
EXPERIMENTS_ROOT=../paper-and-conference-recommendation-experiments
DEMO_ARTIFACTS_DIR=../_local/demo_artifacts
BERT_MODEL_PATH=../_local/models/bert-base-uncased

# Corpus bài báo (4,210 bài) + 5 Facets & Evidence gốc (Exp A - Qwen3-4B)
PAPER_CORPUS_PATH=../paper-and-conference-recommendation-experiments/data/processed/papers.jsonl
CORPUS_FACETS_PATH=../paper-and-conference-recommendation-experiments/data/exp_a/generated/facets_silver.jsonl
CORPUS_EVIDENCE_PATH=../paper-and-conference-recommendation-experiments/data/exp_a/generated/annotation_metadata.jsonl

# Khuyến nghị Hội nghị (Split sạch: 30 hội nghị, 602 Train & 168 Test đã merge Qwen3-8B)
CONFERENCE_CATALOG_PATH=../paper-and-conference-recommendation-experiments/data/conference_recommendation_dataset/5_mapping_reviewed/splits/temporal_2015_2016_2019_clean/conference_catalog.jsonl
CONFERENCE_TRAIN_PATH=../paper-and-conference-recommendation-experiments/data/conference_recommendation_dataset/5_mapping_reviewed/splits/temporal_2015_2016_2019_clean/train.jsonl
CONFERENCE_TEST_PATH=../paper-and-conference-recommendation-experiments/data/conference_recommendation_dataset/5_mapping_reviewed/splits/temporal_2015_2016_2019_clean/test.jsonl

# Thư mục 5 Facets precomputed trên 168 bài Test cho 4 LLM còn lại (Qwen4B, Qwen14B, Llama8B, Gemma9B)
GENERATED_FACETS_DIR=../paper-and-conference-recommendation-experiments/data/conference_recommendation_dataset/generated_facets

# Prompts trích xuất 5 Facets (chế độ Live LLM)
PROMPT_GUIDELINE_PATH=../paper-and-conference-recommendation-experiments/data/exp_a/prompts/guideline_gold_v1.md
PROMPT_EXTRACTION_PATH=../paper-and-conference-recommendation-experiments/data/exp_a/prompts/extraction_gold_v1.md
