{
  "project": "DS300 - Exp B Pooling & Final Ground Truth",
  "version": "v1.0.0",
  "description": "Cấu hình chuẩn cho quy trình Pooling (TREC-style) và Human Relevance Judgment",
  "pooling_parameters": {
    "ground_truth_candidates_top_k": 100,
    "ranking_methods_top_k": 20,
    "deduplication_key": ["query_id", "candidate_id"],
    "allow_self_query": false
  },
  "relevance_scale": {
    "0": "Không liên quan",
    "1": "Có liên quan nhẹ, giá trị sử dụng hạn chế",
    "2": "Có liên quan đáng kể",
    "3": "Rất liên quan, có giá trị tham khảo trực tiếp",
    "UNJUDGED": "Chưa được con người đánh giá (giữ nguyên, không tự gán 0)"
  },
  "splits": {
    "dev_queries_count": 15,
    "test_queries_count": 35
  },
  "paths": {
    "input_gt_candidates": "pooling/input/ground_truth_candidates.jsonl",
    "input_fulltext_ranking": "pooling/input/fulltext_ranking.jsonl",
    "input_equal_weight_ranking": "pooling/input/equal_weight_ranking.jsonl",
    "input_weighted_ranking": "pooling/input/weighted_ranking.jsonl",
    "papers_corpus": "data_preparation/input/papers.jsonl",
    "validated_silver": "data_preparation/output/validated_silver.jsonl",
    "query_split": "ranking/input/query_split.json",
    "output_candidate_pool": "pooling/output/candidate_pool.jsonl",
    "output_deduplicated_pool": "pooling/output/deduplicated_pool.jsonl",
    "output_validation_report": "pooling/output/pool_validation_report.json",
    "human_review_queue": "pooling/human_review/review_queue.jsonl",
    "human_judgments": "pooling/human_review/human_judgments.jsonl",
    "output_final_qrels": "pooling/output/final_human_qrels.jsonl",
    "output_pooling_report": "pooling/output/pooling_report.json",
    "report_analysis": "pooling/reports/POOLING_ANALYSIS.md"
  }
}
