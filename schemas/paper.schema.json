{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "paper_id": {
      "type": "string",
      "pattern": "^P[0-9]{6}$"
    },
    "source": {
      "enum": [
        "csfcube",
        "scifact"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2100
        },
        {
          "type": "null"
        }
      ]
    },
    "domain": {
      "const": "information_technology"
    },
    "scope_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "paper_id",
    "source",
    "source_id",
    "title",
    "abstract",
    "year",
    "domain",
    "scope_evidence"
  ],
  "additionalProperties": false
}
